<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>in.vj</groupId>
	<artifactId>ca_Spring_Web_MVC</artifactId>
	<packaging>war</packaging>
	<version>1.0</version>
	<name>ca_Spring_Web_MVC Maven Webapp</name>
	<url>http://maven.apache.org</url>
	<dependencies>

		<!-- Spring Core Depndency -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-core</artifactId>
			<version>7.0.8</version>
			<scope>compile</scope>
		</dependency>

		<!-- Spring Context Depndency -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
			<version>7.0.8</version>
			<scope>compile</scope>
		</dependency>

		<!-- Spring Context Expression -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-expression</artifactId>
			<version>7.0.8</version>
			<scope>compile</scope>
		</dependency>

		<!-- Spring Web MVC -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webmvc</artifactId>
			<version>7.0.8</version>
			<scope>compile</scope>
		</dependency>


		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<finalName>ca_Spring_Web_MVC</finalName>
	</build>
</project>
