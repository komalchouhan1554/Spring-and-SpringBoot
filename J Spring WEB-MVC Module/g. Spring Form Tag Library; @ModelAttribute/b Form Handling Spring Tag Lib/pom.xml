<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>in.vj</groupId>
	<artifactId>ga_Form_Handling</artifactId>
	<packaging>war</packaging>
	<version>1.0</version>
	<name>ga_Form_Handling Maven Webapp</name>
	<url>http://maven.apache.org</url>
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>


		<!-- Spring Core Depndency -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-core</artifactId>
			<version>7.0.8</version>
			<scope>compile</scope>
		</dependency>

		<!-- Spring Context Depndency -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
			<version>7.0.8</version>
			<scope>compile</scope>
		</dependency>

		<!-- Spring Context Expression -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-expression</artifactId>
			<version>7.0.8</version>
			<scope>compile</scope>
		</dependency>

		<!-- Spring Web MVC -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webmvc</artifactId>
			<version>7.0.8</version>
			<scope>compile</scope>
		</dependency>

		<!-- spring-security-taglibs dependency for spring form tag library -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-taglibs</artifactId>
			<version>7.1.0</version>
			<scope>compile</scope>
		</dependency>

	</dependencies>
	<build>
		<finalName>ga_Form_Handling</finalName>
	</build>
</project>
